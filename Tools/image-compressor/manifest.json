{
    "name": "Image Compressor Pro v2",
    "short_name": "ImgCompressor",
    "description": "Professional image compressor supporting all formats with unlimited size processing",
    "start_url": "/",
    "display": "standalone",
    "background_color": "#ffffff",
    "theme_color": "#3b82f6",
    "orientation": "any",
    "scope": "/",
    "categories": ["productivity", "utilities", "photo"],
    "icons": [
        {
            "src": "assets/icon-192x192.png",
            "sizes": "192x192",
            "type": "image/png",
            "purpose": "any maskable"
        },
        {
            "src": "assets/icon-512x512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "any maskable"
        }
    ],
    "shortcuts": [
        {
            "name": "Compress Images",
            "short_name": "Compress",
            "description": "Start compressing images",
            "url": "/",
            "icons": [
                {
                    "src": "assets/shortcut-compress.png",
                    "sizes": "96x96"
                }
            ]
        },
        {
            "name": "Batch Process",
            "short_name": "Batch",
            "description": "Process multiple images",
            "url": "/?mode=batch",
            "icons": [
                {
                    "src": "assets/shortcut-batch.png",
                    "sizes": "96x96"
                }
            ]
        }
    ],
    "screenshots": [
        {
            "src": "assets/screenshot-desktop.png",
            "sizes": "1280x720",
            "type": "image/png",
            "form_factor": "wide"
        },
        {
            "src": "assets/screenshot-mobile.png",
            "sizes": "375x667",
            "type": "image/png",
            "form_factor": "narrow"
        }
    ],
    "features": [
        "All format support (HEIC, JPEG XL, AVIF, BMP, TIFF, DWG, PSD, PDF)",
        "Unlimited file size and batch count",
        "Client-side processing for privacy",
        "WebAssembly compression algorithms",
        "Bulk operations and renaming",
        "EXIF metadata handling",
        "Social sharing integration",
        "Cloud storage integration"
    ],
    "file_handlers": [
        {
            "action": "/",
            "accept": {
                "image/*": [".jpg", ".jpeg", ".png", ".gif", ".webp", ".avif", ".bmp", ".tiff", ".heic", ".svg", ".ico"],
                "application/pdf": [".pdf"]
            }
        }
    ],
    "share_target": {
        "action": "/",
        "method": "POST",
        "enctype": "multipart/form-data",
        "params": {
            "files": [
                {
                    "name": "image",
                    "accept": ["image/*", "application/pdf"]
                }
            ]
        }
    },
    "prefer_related_applications": false,
    "related_applications": [],
    "lang": "en-US",
    "dir": "ltr"
} 