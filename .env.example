# ── Payload CMS (Phase 2) ────────────────────────────────────────────
# Neon Postgres connection string (https://neon.tech → free project → connection string)
# Format: postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Random secret (generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
PAYLOAD_SECRET=

# Public site URL (View live buttons + preview / SEO canonical)
NEXT_PUBLIC_SITE_URL=https://toolspy.net

# Payload admin host (optional but recommended per Vercel project).
# Agar admin https://dev.toolspy.net pe hai to SET karo:
#   NEXT_PUBLIC_SERVER_URL=https://dev.toolspy.net
# Main production:
#   NEXT_PUBLIC_SERVER_URL=https://toolspy.net
# Local:
#   NEXT_PUBLIC_SERVER_URL=http://localhost:3000
# Agar empty chhodo to Payload request host se infer karta hai; csrf me
# toolspy.net + dev.toolspy.net dono allow list me hain.
# NEXT_PUBLIC_SERVER_URL=

# ── Cloudinary (media storage — free forever) ───────────────────────
# https://cloudinary.com → free account → Dashboard shows all three values.
# When ALL THREE are set, Payload media uploads (blog + tool-page rich text)
# go to Cloudinary's CDN. If left empty, uploads fall back to local disk
# (public/media) — fine for local dev, but NOT persisted on Vercel.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional: top-level folder for uploaded assets (default: toolspy)
# CLOUDINARY_FOLDER=toolspy

# ── Existing (pehle se .env.local me ho to yahan repeat ki zaroorat nahi) ──
# NEXT_PUBLIC_GTM_ID=
# NEXT_PUBLIC_WHOIS_API_KEY=
