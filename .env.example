# ── Payload CMS (Phase 2) ────────────────────────────────────────────
# Neon Postgres connection string (https://neon.tech → free project → connection string)
# Format: postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Random secret (generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
PAYLOAD_SECRET=

# Public site URL (View live buttons + preview)
NEXT_PUBLIC_SITE_URL=https://toolspy.net

# Optional: Payload admin absolute URL (local: http://localhost:3000)
# NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# ── Existing (pehle se .env.local me ho to yahan repeat ki zaroorat nahi) ──
# NEXT_PUBLIC_GTM_ID=
# NEXT_PUBLIC_WHOIS_API_KEY=
